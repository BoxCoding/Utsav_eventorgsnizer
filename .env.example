# Copy to .env and fill in. Without a key Utsav runs in offline mode (curated ideas, rule-based answers).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# UTSAV_OFFLINE=1          # force offline mode
# UTSAV_DB=./utsav.db       # local SQLite file (production uses Firestore)
# WhatsApp Business Cloud API (optional; without it Utsav uses one-tap wa.me links)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_INVITE_TEMPLATE=utsav_invite
# WHATSAPP_REMINDER_TEMPLATE=utsav_reminder
# WHATSAPP_TEMPLATE_LANG=en
